rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(userDoc()) && get(userDoc()).data.active == true; }
    function isMgr() { return isActive() && get(userDoc()).data.isManager == true; }
    function myEmp() { return get(userDoc()).data.empId; }
    function empDoc(id) { return /databases/$(database)/documents/employees/$(id); }

    // נעילת זמינות אחרי הגשה: כבויה רק אם המנהל כיבה אותה במפורש (ברירת מחדל: נעולה)
    function availLockOff() {
      return exists(/databases/$(database)/documents/settings/prefs)
        && get(/databases/$(database)/documents/settings/prefs).data.get('lockAvail', true) == false;
    }
    // שבוע מפורסם: אסור לשנות בו משמרות (המנהל צריך לבטל פרסום קודם)
    function wkPub(ws) {
      return exists(/databases/$(database)/documents/weeks/$(ws))
        && get(/databases/$(database)/documents/weeks/$(ws)).data.get('published', false) == true;
    }

    // קיום מסמך זה אומר שההגדרה הראשונית כבר בוצעה
    match /meta/bootstrap {
      allow read: if true;
      allow create: if isMgr();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMgr());
      allow create: if isMgr() || (signedIn() && request.auth.uid == uid
        && request.resource.data.isManager == true && request.resource.data.active == true
        && !exists(/databases/$(database)/documents/meta/bootstrap));
      // משתמש רשאי רק לסמן שהחליף קוד (mustChange=false) ושהסיסמה חזקה (strong)
      allow update: if isMgr() || (isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange', 'strong'])
        && request.resource.data.mustChange == false);
      allow delete: if isMgr();
    }
    // קודי כניסה כבר לא נשמרים כאן; נשמרים רק טלפון, גרסת חשבון ומזהה חשבון
    match /secrets/{id} {
      allow read, write: if isMgr();
    }
    match /employees/{id} { allow read: if isActive(); allow write: if isMgr(); }
    match /roles/{id}     { allow read: if isActive(); allow write: if isMgr(); }
    match /days/{id}      { allow read: if isActive(); allow write: if isMgr(); }
    match /weeks/{id}     { allow read: if isActive(); allow write: if isMgr(); }
    match /settings/{id}  { allow read: if isActive(); allow write: if isMgr(); }
    match /shifts/{id} {
      allow read: if isActive();
      allow create: if isMgr() && !wkPub(request.resource.data.get('ws', 'none'));
      allow update: if isMgr() && (
        (!wkPub(request.resource.data.get('ws', 'none')) && !wkPub(resource.data.get('ws', 'none')))
        // השלמת שדה ws למשמרות ישנות (מיגרציה חד-פעמית)
        || (!('ws' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ws'])));
      allow delete: if isMgr() && !wkPub(resource.data.get('ws', 'none'));
    }
    // יומן פעולות: כל משתמש פעיל כותב רק רשומה אמיתית על עצמו; רק מנהל קורא/מוחק
    match /logs/{id} {
      allow read, delete: if isMgr();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['id', 'ts', 'empId', 'name', 'mgr', 'type', 'text'])
        && request.resource.data.id == id
        && request.resource.data.empId == myEmp()
        && request.resource.data.name == get(empDoc(myEmp())).data.name
        && request.resource.data.mgr == get(userDoc()).data.isManager
        && request.resource.data.type in ['auth', 'shift', 'auto', 'avail', 'pin', 'emp', 'set', 'pub', 'send']
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.ts is int
        && request.resource.data.ts > request.time.toMillis() - 600000
        && request.resource.data.ts < request.time.toMillis() + 600000;
    }
    match /availability/{id} {
      allow read: if isMgr() || (isActive() && resource.data.empId == myEmp());
      allow create: if isActive() && request.resource.data.empId == myEmp()
        && id == request.resource.data.weekStart + '_' + myEmp();
      // עדכון אחרי הגשה: רק כשהנעילה כבויה (כמו בממשק)
      allow update: if isActive() && request.resource.data.empId == myEmp()
        && id == request.resource.data.weekStart + '_' + myEmp()
        && availLockOff();
      allow delete: if isMgr();
    }
  }
}
